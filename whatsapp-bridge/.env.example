# Copiá este archivo a .env y completá los valores

# Puerto del servicio
PORT=3001

# Clave secreta (la misma va en la hoja Configuracion → whatsapp_bridge_key)
API_KEY=cambiar-por-clave-segura-larga

# Carpeta donde se guarda la sesión de WhatsApp (no borrar después del QR)
AUTH_FOLDER=./auth_info
